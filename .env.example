# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings → API page. See docs/setup.md for the full setup walkthrough,
# including the manual single-user account creation procedure.

# Project URL and anon (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Used by scripts (e.g. one-off admin
# tasks); never imported into client components or exposed via NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Database password (Settings → Database → Database password) — a separate
# secret from the two keys above. Only needed locally, to run
# `supabase db push` / `supabase gen types` against the project; the app
# itself never reads this at runtime.
SUPABASE_DB_PASSWORD=
